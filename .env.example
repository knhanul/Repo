APP_NAME=NUNI Repository
APP_ENV=development
SECRET_KEY=change-this-in-production
DATABASE_URL=sqlite:///./data/nuni_repository.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_DISPLAY_NAME=admin

STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./data/repository

# WebDAV production/test mode
WEBDAV_URL=http://127.0.0.1:8085/dav
WEBDAV_USERNAME=test
WEBDAV_PASSWORD=test
WEBDAV_VERIFY_SSL=true
WEBDAV_TIMEOUT_SECONDS=30

# UI
SHOW_ENV_BADGE=true
MAX_UPLOAD_MB=2048
